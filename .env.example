APP_NAME="Portal IESTP Chincha"
APP_ENV=production
# Se genera con: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-dominio.edu.pe
APP_TIMEZONE=America/Lima

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Base de datos MySQL/MariaDB (en hPanel: Bases de datos › Bases de datos MySQL).
# Una base por sitio: las tablas usan el prefijo fijo pisco_.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=NOMBRE_DE_LA_BASE
DB_USERNAME=USUARIO_DE_LA_BASE
DB_PASSWORD=

# Clave privada aleatoria de al menos 32 caracteres. Se pide al abrir /instalar
# y cifra la configuración SMTP guardada desde la intranet. Guárdala.
PORTAL_INSTALL_KEY=

# Meses de auditoría que se conservan (mínimo 6). 0 la conserva sin límite.
PORTAL_AUDIT_RETENTION_MONTHS=24

# Correo notificador. Lo habitual es configurarlo en la intranet
# (Configuración › Configurar correo notificador). Estos valores son la alternativa.
PORTAL_SMTP_ENABLED=false
PORTAL_SMTP_HOST=smtp.gmail.com
PORTAL_SMTP_PORT=587
PORTAL_SMTP_ENCRYPTION=tls
PORTAL_SMTP_USERNAME=notificaciones@instituto.edu.pe
PORTAL_SMTP_PASSWORD=
PORTAL_SMTP_FROM_EMAIL=notificaciones@instituto.edu.pe
PORTAL_SMTP_FROM_NAME="Notificaciones · IESTP Chincha"

# Sesión de 30 minutos de inactividad; la cookie solo viaja por HTTPS.
SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_COOKIE=PISCOSESSID
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
